<?xml version="1.0" encoding="utf-8"?>
<!-- Exam countdown widget (grades-agent; card style by countdown-agent): next 1-3 planner exams. Texts are set at runtime. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ex_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/ex_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/grades_widget_header" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold"
        android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart" />
    <TextView android:id="@+id/ex_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/grades_widget_empty" android:textColor="@color/muted" android:textSize="13sp" android:paddingTop="10dp"
        android:textAlignment="viewStart" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="2dp">
        <FrameLayout android:id="@+id/ex_row0" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:visibility="gone">
            <ImageView android:id="@+id/ex_bar0" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/widget_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:minHeight="52dp" android:paddingStart="10dp" android:paddingEnd="4dp"
                android:paddingTop="4dp" android:paddingBottom="4dp">
                <ImageView android:id="@+id/ex_icon0" android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_marginEnd="10dp" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/ex_title0" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"
                        android:textAlignment="viewStart" />
                    <TextView android:id="@+id/ex_sub0" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#DDFFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"
                        android:textAlignment="viewStart" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="64dp"
                    android:layout_marginStart="8dp" android:background="@drawable/widget_block" android:orientation="vertical"
                    android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp">
                    <TextView android:id="@+id/ex_num0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false" />
                    <TextView android:id="@+id/ex_unit0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF" android:textSize="11sp" android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/ex_row1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:visibility="gone">
            <ImageView android:id="@+id/ex_bar1" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/widget_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:minHeight="52dp" android:paddingStart="10dp" android:paddingEnd="4dp"
                android:paddingTop="4dp" android:paddingBottom="4dp">
                <ImageView android:id="@+id/ex_icon1" android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_marginEnd="10dp" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/ex_title1" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"
                        android:textAlignment="viewStart" />
                    <TextView android:id="@+id/ex_sub1" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#DDFFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"
                        android:textAlignment="viewStart" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="64dp"
                    android:layout_marginStart="8dp" android:background="@drawable/widget_block" android:orientation="vertical"
                    android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp">
                    <TextView android:id="@+id/ex_num1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false" />
                    <TextView android:id="@+id/ex_unit1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF" android:textSize="11sp" android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
        <FrameLayout android:id="@+id/ex_row2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:visibility="gone">
            <ImageView android:id="@+id/ex_bar2" android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/widget_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:minHeight="52dp" android:paddingStart="10dp" android:paddingEnd="4dp"
                android:paddingTop="4dp" android:paddingBottom="4dp">
                <ImageView android:id="@+id/ex_icon2" android:layout_width="22dp" android:layout_height="22dp"
                    android:layout_marginEnd="10dp" android:importantForAccessibility="no" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/ex_title2" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" android:textStyle="bold"
                        android:textAlignment="viewStart" />
                    <TextView android:id="@+id/ex_sub2" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#DDFFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"
                        android:textAlignment="viewStart" />
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="64dp"
                    android:layout_marginStart="8dp" android:background="@drawable/widget_block" android:orientation="vertical"
                    android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp">
                    <TextView android:id="@+id/ex_num2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false" />
                    <TextView android:id="@+id/ex_unit2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF" android:textSize="11sp" android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
