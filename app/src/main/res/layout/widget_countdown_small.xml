<?xml version="1.0" encoding="utf-8"?>
<!-- countdown-agent: single-event countdown widget, small (2×2): details on top, number block below. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cd_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/cd_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_card" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"
            android:paddingStart="4dp" android:paddingEnd="4dp">
            <FrameLayout android:layout_width="36dp" android:layout_height="36dp">
                <ImageView android:id="@+id/cd_ring" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/widget_ring" android:importantForAccessibility="no" />
                <ImageView android:id="@+id/cd_icon" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:padding="8dp" android:importantForAccessibility="no" />
            </FrameLayout>
            <TextView android:id="@+id/cd_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold"
                android:maxLines="2" android:ellipsize="end" android:textAlignment="viewStart" />
            <TextView android:id="@+id/cd_date" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#DDFFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cd_block" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/widget_block" android:orientation="vertical" android:gravity="center"
            android:paddingTop="6dp" android:paddingBottom="6dp" android:paddingStart="8dp" android:paddingEnd="8dp">
            <TextView android:id="@+id/cd_num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="34sp" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false" />
            <Chronometer android:id="@+id/cd_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="24sp" android:textStyle="bold" android:maxLines="1" android:visibility="gone" />
            <TextView android:id="@+id/cd_unit" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="13sp" android:maxLines="1" />
            <TextView android:id="@+id/cd_small" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#DDFFFFFF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
